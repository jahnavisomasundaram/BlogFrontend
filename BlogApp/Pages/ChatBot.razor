@page "/chatbot"
@using System.Text.Json

@using SystemJsonSerializer = System.Text.Json.JsonSerializer
@using SystemJsonElement = System.Text.Json.JsonElement

@inject HttpClient Http
@inject IJSRuntime JSRuntime
@using Markdig
@using MudBlazor
@layout GeneralLayout

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-8" Style="height: 85vh;">
    <MudPaper Height="100%" Class="d-flex flex-column rounded-xl overflow-hidden shadow-xl" Style="border: 1px solid var(--mud-palette-lines-default);">

        <div class="d-flex align-center pa-4" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
            <MudAvatar Color="Color.Surface" Class="mr-3">
                <MudIcon Icon="@Icons.Material.Filled.SmartToy" Color="Color.Primary" />
            </MudAvatar>
            <div>
                <MudText Typo="Typo.h6" Style="font-weight: 700; line-height: 1.2;">AI Assistant</MudText>
                <div class="d-flex align-center">
                    <div style="width: 8px; height: 8px; background-color: #4caf50; border-radius: 50%; margin-right: 6px;"></div>
                    <MudText Typo="Typo.caption" Style="opacity: 0.9;">Online</MudText>
                </div>
            </div>
            <MudSpacer />
            <MudIconButton Icon="@Icons.Material.Filled.Refresh" Color="Color.Inherit" OnClick="ClearChat" Title="Clear Chat" />
        </div>

        <div id="chatContainer" class="flex-1 overflow-y-auto pa-4" style="background-color: var(--mud-palette-background-grey); scroll-behavior: smooth;">
            <MudStack Spacing="2">

                @if (messages.Count == 0)
                {
                    <div class="d-flex justify-center mt-4">
                        <span style="background-color: var(--mud-palette-surface); color: var(--mud-palette-text-primary); padding: 4px 12px; border-radius: 16px; font-size: 0.75rem; font-weight: 500; border: 1px solid var(--mud-palette-lines-default);">
                            Today
                        </span>
                    </div>
                    <MudText Typo="Typo.caption" Align="Align.Center" Class="mb-4" Style="color: var(--mud-palette-text-secondary);">
                        Hello! I am your Blog Assistant. Ask me anything about writing stories or managing your profile.
                    </MudText>
                }

                @foreach (var message in messages)
                {
                    <div class="d-flex w-100 @(message.IsUser ? "justify-end" : "justify-start") animate-fade-in">

                        @if (!message.IsUser)
                        {
                            <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-2 mt-1">
                                <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />
                            </MudAvatar>
                        }

                        <div class="pa-3 px-4"
                             style="@(message.IsUser
                                                                  ? "background: var(--mud-palette-primary); color: var(--mud-palette-primary-text); border-radius: 18px 18px 4px 18px; max-width: 80%; box-shadow: 0 2px 5px rgba(0,0,0,0.1);"
                                                                  : "background: var(--mud-palette-surface); color: var(--mud-palette-text-primary); border-radius: 18px 18px 18px 4px; max-width: 80%; border: 1px solid var(--mud-palette-lines-default); box-shadow: 0 1px 2px rgba(0,0,0,0.05);")">

                        <div class="chat-markdown">
                            @((MarkupString)ConvertMarkdownToHtml(message.Text))
                        </div>
                    </div>

                    </div>
                                }

                @if (isBotTyping)
                {
                    <div class="d-flex justify-start align-center w-100 mt-2">
                        <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-2">
                            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />
                        </MudAvatar>
                        <div class="pa-3" style="background: var(--mud-palette-surface); border-radius: 18px 18px 18px 4px; border: 1px solid var(--mud-palette-lines-default);">
                            <div class="typing-indicator">
                                <span></span><span></span><span></span>
                            </div>
                        </div>
                    </div>
                }

                <div id="scrollTarget"></div>
            </MudStack>
        </div>

        <MudPaper Elevation="0" Class="pa-4 d-flex align-center" Style="border-top: 1px solid var(--mud-palette-lines-default); background: var(--mud-palette-surface);">
            <MudTextField @bind-Value="userMessage"
                          Placeholder="Type your message..."
                          Variant="Variant.Outlined"
                          Class="rounded-pill-input"
                          Margin="Margin.Dense"
                          FullWidth="true"
                          Adornment="Adornment.End"
                          AdornmentIcon="@Icons.Material.Filled.Send"
                          AdornmentColor="Color.Primary"
                          OnAdornmentClick="SendMessage"
                          OnKeyPress="HandleEnter"
                          Disabled="isBotTyping"
                          Immediate="true" />
        </MudPaper>

    </MudPaper>
</MudContainer>

<style>
    /* Styling for the rounded input field - DARK MODE FIX */
    .rounded-pill-input .mud-input-control-input-container {
        border-radius: 99px !important;
        background-color: var(--mud-palette-background-grey) !important; /* Adapted to theme */
    }

    .rounded-pill-input .mud-input-outlined-border {
        border-color: var(--mud-palette-lines-default) !important;
    }

    /* Markdown Styling - DARK MODE FIX */
    .chat-markdown {
        font-family: 'Roboto', sans-serif;
        line-height: 1.6;
        color: inherit; /* Inherit text color from parent bubble */
    }

        .chat-markdown h1,
        .chat-markdown h2,
        .chat-markdown h3 {
            font-weight: 700;
            margin-top: 16px;
            margin-bottom: 8px;
            color: var(--mud-palette-text-primary) !important; /* Dynamic text color */
        }

        .chat-markdown h3 {
            font-size: 1.1rem;
        }

        /* Fix for Lists */
        .chat-markdown ul,
        .chat-markdown ol {
            padding-left: 24px !important;
            margin-bottom: 12px;
        }

        .chat-markdown ul {
            list-style-type: disc !important;
        }

        .chat-markdown ol {
            list-style-type: decimal !important;
        }

        .chat-markdown li {
            margin-bottom: 4px;
            color: inherit;
        }

        /* Bold Text */
        .chat-markdown strong {
            color: var(--mud-palette-text-primary) !important; /* Dynamic bold color */
            font-weight: 700;
        }

        .chat-markdown p {
            margin-bottom: 12px;
        }

        /* Code blocks (Optional enhancement) */
        .chat-markdown code {
            background-color: var(--mud-palette-background-grey);
            padding: 2px 4px;
            border-radius: 4px;
            font-family: monospace;
        }

    /* Animation & Typing Indicator (Unchanged) */
    .animate-fade-in {
        animation: fadeIn 0.3s ease-in-out;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .typing-indicator {
        display: flex;
        align-items: center;
        gap: 4px;
    }

        .typing-indicator span {
            display: block;
            width: 6px;
            height: 6px;
            background-color: var(--mud-palette-text-secondary); /* Dynamic dots color */
            border-radius: 50%;
            animation: typing 1.4s infinite ease-in-out both;
        }

            .typing-indicator span:nth-child(1) {
                animation-delay: -0.32s;
            }

            .typing-indicator span:nth-child(2) {
                animation-delay: -0.16s;
            }

    @@keyframes typing {
        0%, 80%, 100% {
            transform: scale(0);
        }

        40% {
            transform: scale(1);
        }
    }
</style>

@code {
    private string userMessage = "";
    private List<ChatMessage> messages = new();
    private bool isBotTyping = false;

    private class ChatMessage
    {
        public string Text { get; set; } = "";
        public bool IsUser { get; set; }
    }

    private void ClearChat()
    {
        messages.Clear();
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userMessage) || isBotTyping)
            return;

        var newUserMessage = new ChatMessage { Text = userMessage, IsUser = true };
        messages.Add(newUserMessage);

        var question = userMessage;
        userMessage = ""; // Clear input immediately
        isBotTyping = true;

        // Small delay to allow UI to render the user message before scrolling
        await Task.Delay(50);
        await ScrollToBottom();

        try
        {
            // Ensure this URL matches your backend API port
            var jsonString = SystemJsonSerializer.Serialize(question);
            var content = new StringContent(jsonString, System.Text.Encoding.UTF8, "application/json");

            var response = await Http.PostAsync("/api/chat", content);
            if (response.IsSuccessStatusCode)
            {
                var responseText = await response.Content.ReadAsStringAsync();
                var json = SystemJsonSerializer.Deserialize<SystemJsonElement>(responseText);

                // Handle different JSON structures safely
                string reply = "I couldn't understand that.";
                if (json.TryGetProperty("reply", out var replyProp))
                {
                    reply = replyProp.GetString();
                }

                messages.Add(new ChatMessage { Text = reply ?? "No response.", IsUser = false });
            }
            else
            {
                messages.Add(new ChatMessage { Text = $"⚠️ I'm having trouble connecting. (Error: {response.StatusCode})", IsUser = false });
            }
        }
        catch (Exception)
        {
            messages.Add(new ChatMessage { Text = "⚠️ Connection error. Please ensure the backend server is running.", IsUser = false });
        }
        finally
        {
            isBotTyping = false;
            await Task.Delay(50);
            await ScrollToBottom();
        }
    }

    private async Task HandleEnter(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    private async Task ScrollToBottom()
    {
        try
        {
            // Scroll to the hidden div at the bottom
            await JSRuntime.InvokeVoidAsync("eval", "document.getElementById('scrollTarget').scrollIntoView({ behavior: 'smooth' });");
        }
        catch
        {
            // Ignore JS errors if element missing during navigation
        }
    }

    // Add this helper method
    private string ConvertMarkdownToHtml(string markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return "";
        var pipeline = new Markdig.MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
        return Markdig.Markdown.ToHtml(markdown, pipeline);
    }
}

