@page "/profile1/{name}"
@layout GeneralLayout
@using BlogApp.Models
@using MudBlazor
@using System.Net.Http.Headers
@using System.Text.Json
@using Newtonsoft.Json

@using SystemJsonSerializer = System.Text.Json.JsonSerializer
@using SystemJsonElement = System.Text.Json.JsonElement

@inject UserData Data
@inject NavigationManager Navigation
@inject HttpClient http
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.Medium" Class="my-8">

    <MudPaper Elevation="0" Class="rounded-xl overflow-hidden mb-8 border-1 border-solid mud-border-lines-default" Style="background: white;">

        <div style="height: 160px; background: linear-gradient(to right, #6a11cb 0%, #2575fc 100%);"></div>

        <div class="px-8 pb-6">
            <div class="d-flex justify-space-between align-start relative">

                <div style="margin-top: -65px;">
                    <MudAvatar Style="width:130px; height:130px; border: 4px solid white; font-size: 3rem;" Color="Color.Secondary">
                        @(!string.IsNullOrEmpty(name) ? name[0].ToString().ToUpper() : "?")
                    </MudAvatar>
                </div>

                <div class="d-flex flex-column align-center mt-3" style="flex-grow: 1;">
                    <MudText Typo="Typo.h4" Class="font-bold text-gray-900">@name</MudText>
                    <MudText Typo="Typo.body1" Class="text-gray-500">@email</MudText>
                    <MudText Typo="Typo.body2" Class="text-gray-600 mt-2 d-flex align-center gap-1">
                        Tech Blogger & UI Enthusiast from India 🌏
                    </MudText>
                </div>

                <div class="mt-4">
                    <MudButton Variant="@(isFollowing? Variant.Outlined: Variant.Filled)"
                               Color="@(isFollowing ? Color.Secondary : Color.Primary)"
                               Class="rounded-pill px-6"
                               OnClick="FollowUser"
                               StartIcon="@(isFollowing ? Icons.Material.Filled.PersonRemove : Icons.Material.Filled.PersonAdd)">
                        @(isFollowing ? "Unfollow" : "Follow")
                    </MudButton>
                </div>
            </div>

            <MudGrid Class="mt-8 justify-center">
                <MudItem xs="3" Class="text-center">
                    <MudText Typo="Typo.h5" Class="font-bold text-gray-800">@followerCount</MudText>
                    <MudText Typo="Typo.caption" Class="text-gray-500 font-bold uppercase tracking-wide">Followers</MudText>
                </MudItem>
                <MudItem xs="3" Class="text-center">
                    <MudText Typo="Typo.h5" Class="font-bold text-gray-800">@followingCount</MudText>
                    <MudText Typo="Typo.caption" Class="text-gray-500 font-bold uppercase tracking-wide">Following</MudText>
                </MudItem>
                <MudItem xs="3" Class="text-center">
                    <MudText Typo="Typo.h5" Class="font-bold text-gray-800">548</MudText>
                    <MudText Typo="Typo.caption" Class="text-gray-500 font-bold uppercase tracking-wide">Likes</MudText>
                </MudItem>
            </MudGrid>
        </div>
    </MudPaper>

    <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" PanelClass="mt-8" Color="Color.Transparent" SliderColor="Color.Primary" Centered="true">

        <MudTabPanel Text="STORIES" Icon="@Icons.Material.Filled.Article">
            @if (userBlogs == null)
            {
                <div class="d-flex justify-center py-10"><MudProgressCircular Indeterminate="true" Color="Color.Primary" /></div>
            }
            else if (userBlogs.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Class="rounded-xl">No stories published yet.</MudAlert>
            }
            else
            {
                <div class="px-2">
                    @foreach (var blog in userBlogs)
                    {
                        <div class="d-flex gap-6 py-6 border-b-1 border-gray-200" style="border-bottom: 1px solid #f0f0f0;">

                            <div class="d-flex flex-column justify-between" style="flex: 1; min-width: 0;">
                                <div>
                                    <div class="d-flex align-center gap-2 mb-2">
                                        <MudAvatar Size="Size.Small" Style="width:20px; height:20px; font-size: 0.7rem;">
                                            @(!string.IsNullOrEmpty(blog.AuthorName) ? blog.AuthorName[0].ToString().ToUpper() : "?")
                                        </MudAvatar>
                                        <MudText Typo="Typo.caption" Class="font-bold text-gray-800">@blog.AuthorName</MudText>
                                        <MudText Typo="Typo.caption" Class="text-gray-400">·</MudText>
                                        <MudText Typo="Typo.caption" Class="text-gray-500">
                                            @(blog.CreatedAt?.ToString("MMM dd, yyyy") ?? "Date unknown")
                                        </MudText>
                                        @if (blog.Visibility == "Private")
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="text-gray-400 ml-1" Style="font-size: 14px;" />
                                        }
                                    </div>

                                    <div class="cursor-pointer blog-link" @onclick="@(() => JS.InvokeVoidAsync("eval", $"window.location.href = '/blog/{blog.Id}';"))">
                                        <MudText Typo="Typo.h6" Class="font-bold mb-1 text-gray-900 leading-tight" Style="font-weight: 800; font-family: 'Merriweather', serif;">
                                            @blog.Title
                                        </MudText>
                                        <MudText Typo="Typo.body2" Class="text-gray-600 mb-2 line-clamp-2" Style="line-height: 1.5;">
                                            @blog.Subtitle
                                        </MudText>
                                    </div>
                                </div>

                                <div class="d-flex align-center mt-3">
                                    <MudText Typo="Typo.caption" Class="text-gray-500">3 min read</MudText>
                                    <MudSpacer />
                                    <MudIconButton Icon="@Icons.Material.Outlined.BookmarkAdd" Size="Size.Small" Class="text-gray-400" />
                                </div>
                            </div>

                            @if (!string.IsNullOrEmpty(blog.ImageUrl))
                            {
                                <div class="d-none d-sm-block flex-shrink-0" @onclick="@(() => JS.InvokeVoidAsync("eval", $"window.location.href = '/blog/{blog.Id}';"))" style="cursor: pointer;">
                                    <MudImage Src="@blog.ImageUrl" ObjectFit="ObjectFit.Cover" Class="rounded-lg" Style="width: 160px; height: 112px;" />
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </MudTabPanel>

        <MudTabPanel Text="FOLLOWERS" Icon="@Icons.Material.Filled.Group">
            @if (followerCount == 0)
            {
                <div class="d-flex flex-column align-center justify-center py-10 opacity-50">
                    <MudIcon Icon="@Icons.Material.Filled.SentimentDissatisfied" Size="Size.Large" />
                    <MudText Class="mt-2">No followers yet.</MudText>
                </div>
            }
            else
            {
                <div class="mt-4 px-2" style="max-width: 600px; margin: 0 auto;">
                    @foreach (var f in Followers)
                    {
                        <div class="d-flex justify-space-between align-center py-4 hover-row cursor-pointer"
                             style="border-bottom: 1px solid var(--mud-palette-lines-default);"
                             @onclick="@(() => JS.InvokeVoidAsync("eval", $"window.location.href = '/profile1/{f.UserName}?email={f.Email}';"))">

                                <div class="d-flex justify-space-between align-center py-4 border-b-1 border-gray-100" style="border-bottom: 1px solid #f0f0f0;">
                            <div class="d-flex align-center gap-4">
                                <MudAvatar Color="Color.Secondary" Variant="Variant.Filled" Size="Size.Medium">
                                    @(!string.IsNullOrEmpty(f.UserName) ? f.UserName[0].ToString().ToUpper() : "?")
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="font-bold">@f.UserName</MudText>
                                </div>
                            </div>
                        </div>
                        </div>
                    }
                </div>
            }
        </MudTabPanel>

        <MudTabPanel Text="FOLLOWING" Icon="@Icons.Material.Filled.PersonAdd">
            @if (followingCount == 0)
            {
                <div class="d-flex flex-column align-center justify-center py-10 opacity-50">
                    <MudIcon Icon="@Icons.Material.Filled.PersonSearch" Size="Size.Large" />
                    <MudText Class="mt-2">Not following anyone yet.</MudText>
                </div>
            }
            else
            {
                <div class="mt-4 px-2" style="max-width: 600px; margin: 0 auto;">
                    @foreach (var f in Following)
                    {
                        <div class="d-flex justify-space-between align-center py-4 hover-row cursor-pointer"
                             style="border-bottom: 1px solid var(--mud-palette-lines-default);"
                             @onclick="@(() => JS.InvokeVoidAsync("eval", $"window.location.href = '/profile1/{f.UserName}?email={f.Email}';"))">

                                <div class="d-flex justify-space-between align-center py-4 border-b-1 border-gray-100" style="border-bottom: 1px solid #f0f0f0;">
                            <div class="d-flex align-center gap-4">
                                <MudAvatar Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Medium">
                                    @(!string.IsNullOrEmpty(f.UserName) ? f.UserName[0].ToString().ToUpper() : "?")
                                </MudAvatar>
                                <div>
                                    <MudText Typo="Typo.subtitle2" Class="font-bold">@f.UserName</MudText>
                                </div>
                            </div>
                        </div>
                        </div>
                    }
                </div>
            }
        </MudTabPanel>

    </MudTabs>

</MudContainer>

@code {
    public List<UserMiniDto> Followers { get; set; } = new();
    public List<UserMiniDto> Following { get; set; } = new();

    private List<BlogEntry> userBlogs = new();

    private bool isFollowing = false;
    private int followerCount = 0;
    private int followingCount = 0;

    public class UserMiniDto
    {
        public string UserName { get; set; }
        public string Email { get; set; }
    }


    [Parameter] public string name { get; set; }
    [Parameter][SupplyParameterFromQuery] public string email { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var jwt = await JS.InvokeAsync<string>("localStorage.getItem", "jwt");

        if (string.IsNullOrWhiteSpace(jwt))
        {
            await JS.InvokeVoidAsync("eval", "window.location.href = '/';");
            return;
        }

        http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);

        var statsResponse = await http.GetAsync($"/api/Auth/userstats?email={email}");
        if (statsResponse.IsSuccessStatusCode)
        {
            var json = await statsResponse.Content.ReadAsStringAsync();
            using var document = JsonDocument.Parse(json);
            var root = document.RootElement;

            Followers = root.GetProperty("followers")
    .EnumerateArray()
    .Select(f => new UserMiniDto
    {
        UserName = f.GetProperty("userName").GetString(),
        Email = f.GetProperty("email").GetString()
    })
    .ToList();

            Following = root.GetProperty("following")
                .EnumerateArray()
                .Select(f => new UserMiniDto
                {
                    UserName = f.GetProperty("userName").GetString(),
                    Email = f.GetProperty("email").GetString()
                })
                .ToList();

            followerCount = root.GetProperty("followerCount").GetInt32();
            followingCount = root.GetProperty("followingCount").GetInt32();
        }

        var followCheckResponse = await http.GetAsync($"/api/Auth/isfollowing?targetUserEmail={email}");
        if (followCheckResponse.IsSuccessStatusCode)
        {
            var resultJson = await followCheckResponse.Content.ReadAsStringAsync();
            var result = SystemJsonSerializer.Deserialize<SystemJsonElement>(resultJson);
            isFollowing = result.GetProperty("isFollowing").GetBoolean();
        }

        var resBlogs = await http.GetAsync($"/api/Auth/getBlogs?email={email}");
        if (resBlogs.IsSuccessStatusCode)
        {
            var blogsJson = await resBlogs.Content.ReadAsStringAsync();
            var allUserBlogs = JsonConvert.DeserializeObject<List<BlogEntry>>(blogsJson) ?? new(); userBlogs = allUserBlogs
                .Where(blog => blog.Visibility == "Public" || (isFollowing && blog.Visibility == "Private"))
                .ToList();
        }
    }

    private async Task FollowUser()
    {
        var jsonString = SystemJsonSerializer.Serialize(email);
        var content = new StringContent(jsonString, System.Text.Encoding.UTF8, "application/json");
        var response = await http.PostAsync("/api/Auth/follow", content);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<JsonElement>();
            bool nowFollowing = result.GetProperty("followed").GetBoolean();

            if (nowFollowing)
            {
                followerCount++;
            }
            else
            {
                followerCount--;
            }

            isFollowing = nowFollowing;

            // Refresh blogs to update visibility (e.g. unlock private blogs)
            var resBlogs = await http.GetAsync($"/api/Auth/getBlogs?email={email}");
            if (resBlogs.IsSuccessStatusCode)
            {
                var blogsJson = await resBlogs.Content.ReadAsStringAsync();
                var allUserBlogs = JsonConvert.DeserializeObject<List<BlogEntry>>(blogsJson) ?? new(); userBlogs = allUserBlogs
                    .Where(blog => blog.Visibility == "Public" || (isFollowing && blog.Visibility == "Private"))
                    .ToList();
            }
        }
        else
        {
            var error = await response.Content.ReadAsStringAsync();
            Console.WriteLine($"Follow API failed: {response.StatusCode} - {error}");
        }
    }
}

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .blog-link:hover .mud-typography-h6 {
        text-decoration: underline;
        text-decoration-thickness: 1px;
    }
</style>