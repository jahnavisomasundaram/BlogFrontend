    protected override async Task OnInitializedAsync()
    {
        var jwt = await JS.InvokeAsync<string>("localStorage.getItem", "jwt");

        if (string.IsNullOrWhiteSpace(jwt))
        {
            await JS.InvokeVoidAsync("eval", "window.location.href = '/';");
            return;
        }

        http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", jwt);

        var claims = DecodeJwtPayload(jwt);

        if (claims.TryGetValue("email", out var emailObj))
        {
            Data.Email = emailObj?.ToString();

            try
            {
                var nameResponse = await http.GetAsync($"/api/Auth/getuser?email={Data.Email}");
                if (nameResponse.IsSuccessStatusCode)
                {
                    Data.Name = await nameResponse.Content.ReadAsStringAsync();
                    Data.Name = Data.Name?.Trim('"');
                }
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error getting username: {ex.Message}");
            }
        }

        if (string.IsNullOrWhiteSpace(Data.Name))
        {
            if (claims.TryGetValue("user_metadata", out var userMetaObj) && userMetaObj is JsonElement userMetaElement)
            {
                if (userMetaElement.TryGetProperty("name", out var nameElement))
                {
                    Data.Name = nameElement.GetString();
                }
            }
        }

        try
        {
            //✅ Use Newtonsoft.Json
            var blogsResponse = await http.GetAsync("/api/Auth/blogs");
            if (blogsResponse.IsSuccessStatusCode)
            {
                var blogsJson = await blogsResponse.Content.ReadAsStringAsync();
                allBlogs = JsonConvert.DeserializeObject<List<BlogEntry>>(blogsJson) ?? new List<BlogEntry>();

                allBlogs = allBlogs
                    .Where(b => b.Published == true)
                    .OrderByDescending(b => b.CreatedAt)
                    .ToList();
            }
            else
            {
                allBlogs = new List<BlogEntry>();
            }

            //✅ Use Newtonsoft.Json for following list
            var followingResponse = await http.GetAsync("/api/Auth/following");
            if (followingResponse.IsSuccessStatusCode)
            {
                var followingJson = await followingResponse.Content.ReadAsStringAsync();
                followingEmails = JsonConvert.DeserializeObject<List<string>>(followingJson) ?? new List<string>();
            }
            else
            {
                followingEmails = new List<string>();
            }

            publicBlogs = allBlogs.Where(b =>
                b.Visibility == "Public" ||
                (b.Visibility == "Private" && (followingEmails.Contains(b.AuthorEmail) || b.AuthorEmail == Data.Email))
            ).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching blogs: {ex.Message}");
            Console.WriteLine($"Stack trace: {ex.StackTrace}");
            allBlogs = new List<BlogEntry>();
            publicBlogs = new List<BlogEntry>();
        }
    }

    private Dictionary<string, object> DecodeJwtPayload(string jwt)
    {
        var parts = jwt.Split('.');
        if (parts.Length != 3)
            throw new ArgumentException("Invalid JWT format");

        var payload = parts[1];
        int padding = 4 - (payload.Length % 4);
        if (padding < 4)
            payload += new string('=', padding);

        var bytes = Convert.FromBase64String(payload);
        var json = System.Text.Encoding.UTF8.GetString(bytes);

        return JsonConvert.DeserializeObject<Dictionary<string, object>>(json)
                ?? new Dictionary<string, object>();
    }
}

<style>
    /* Import Google Fonts */
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Merriweather:wght@400;700;900&display=swap');

    /* Font Classes */
    .font-serif {
        font-family: 'Merriweather', serif !important;
    }

    .font-ui, .font-header {
        font-family: 'Inter', sans-serif !important;
    }

    /* Hover scale effect */
    .group:hover .group-hover\:scale-105 {
        transform: scale(1.05);
    }

    .group:hover .group-hover\:text-primary {
        color: var(--mud-palette-primary) !important;
    }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    /* Horizontal Card Image Sizing */
    .horizontal-card-image {
        width: 100%;
        height: 200px;
    }

    @@media (min-width: 600px) {
        .horizontal-card-image {
            width: 280px !important;
            height: auto !important;
            min-height: 200px;
        }
    }
</style>