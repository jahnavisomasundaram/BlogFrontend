@page "/mainpage"
@layout GeneralLayout
@using BlogApp.Models
@using System.Text.Json
@using System.Net;
@using System.Net.Http.Headers
@using BlogApp.Models
@using Newtonsoft.Json

@inject NavigationManager Navigation
@inject UserData Data
@inject HttpClient http

<MudContainer MaxWidth="MaxWidth.Large" Class="py-12" Style="min-height:100vh;">

    <div class="mb-10">
        <MudText Typo="Typo.h3" Class="font-bold text-gray-900 mb-2 font-header">Discover</MudText>
        <MudText Typo="Typo.subtitle1" Class="text-gray-500 font-ui">News, stories, and ideas from the community.</MudText>
    </div>

    @if (publicBlogs.Any())
    {
        <div class="d-flex align-center gap-2 mb-6">
            <MudIcon Icon="@Icons.Material.Filled.AutoAwesome" Color="Color.Warning" />
            <MudText Typo="Typo.h6" Class="font-bold font-ui">Featured Stories</MudText>
        </div>

        <MudGrid Class="mb-12" Spacing="4">
            @foreach (var blog in publicBlogs.Take(3))
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudPaper Elevation="0" Class="h-100 rounded-xl overflow-hidden border-1 border-solid mud-border-lines-default hover:shadow-lg transition-all cursor-pointer group"
                              @onclick="@(async () => await JS.InvokeVoidAsync("eval", $"window.location.href = '/blog/{blog.Id}';"))">

                        <div class="overflow-hidden position-relative" style="height: 200px;">
                            <MudImage Src="@blog.ImageUrl" ObjectFit="ObjectFit.Cover" Class="w-100 h-100 transition-transform duration-500 group-hover:scale-105" />
                            <div class="absolute top-2 left-2">
                                <div class="absolute top-2 left-2">
                                    <span style="background-color: white; color: black; padding: 4px 12px; border-radius: 16px; font-size: 0.75rem; font-weight: bold;">
                                        Featured
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="pa-5 d-flex flex-column h-100">
                            <MudText Typo="Typo.h6" Class="font-bold mb-2 leading-tight group-hover:text-primary transition-colors font-serif">
                                @blog.Title
                            </MudText>

                            <MudText Typo="Typo.body2" Class="text-gray-500 mb-4 line-clamp-2 font-ui" Style="flex-grow: 1;">
                                @blog.Subtitle
                            </MudText>

                            <div class="d-flex align-center justify-space-between mt-auto font-ui">
                                <div class="d-flex align-center gap-2">
                                    <MudAvatar Size="Size.Small" Class="text-xs">
                                        @(!string.IsNullOrEmpty(blog.AuthorName) ? blog.AuthorName[0].ToString().ToUpper() : "?")
                                    </MudAvatar>
                                    <div>
                                        <MudText Typo="Typo.caption" Class="font-bold block text-gray-800" Style="line-height: 1;">@blog.AuthorName</MudText>
                                        <MudText Typo="Typo.caption" Class="text-gray-400" Style="font-size: 0.7rem;">
                                            @(blog.CreatedAt?.ToString("MMM dd") ?? "")
                                        </MudText>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }

    <div class="d-flex align-center gap-2 mb-6 border-t-1 border-gray-200 pt-8">
        <MudIcon Icon="@Icons.Material.Filled.AccessTime" Color="Color.Primary" />
        <MudText Typo="Typo.h6" Class="font-bold font-ui">Latest Stories</MudText>
    </div>

    <div class="d-flex flex-column gap-4">
        @foreach (var blog in publicBlogs)
        {
            <MudPaper Elevation="0"
                      Class="d-flex flex-column flex-sm-row rounded-xl overflow-hidden border-1 border-solid mud-border-lines-default hover:shadow-md transition-all cursor-pointer group"
                      @onclick="@(async () => await JS.InvokeVoidAsync("eval", $"window.location.href = '/blog/{blog.Id}';"))">

                <div class="overflow-hidden position-relative horizontal-card-image">
                    @if (!string.IsNullOrEmpty(blog.ImageUrl))
                    {
                        <MudImage Src="@blog.ImageUrl" ObjectFit="ObjectFit.Cover" Class="w-100 h-100 transition-transform duration-500 group-hover:scale-105" />
                    }
                    else
                    {
                        <div class="w-100 h-100 d-flex justify-center align-center bg-gray-100">
                            <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Large" Class="text-gray-300" />
                        </div>
                    }
                </div>

                <div class="pa-4 pa-sm-6 d-flex flex-column flex-grow-1" style="min-width: 0;">

                    <div class="d-flex justify-space-between align-center mb-2 font-ui">
                        <MudText Typo="Typo.caption" Class="text-gray-400 font-bold uppercase tracking-wide">
                            @(blog.CreatedAt?.ToString("MMMM dd, yyyy") ?? "UNKNOWN")
                        </MudText>
                    </div>

                    <MudText Typo="Typo.h5" Class="font-bold mb-2 leading-tight group-hover:text-primary transition-colors font-serif">
                        @blog.Title
                    </MudText>

                    <MudText Typo="Typo.body2" Class="text-gray-500 mb-4 line-clamp-2 font-ui" Style="flex-grow: 1;">
                        @blog.Subtitle
                    </MudText>

                    <MudDivider Class="my-3" />

                    <div class="d-flex align-center justify-space-between mt-auto font-ui">
                        <div class="d-flex align-center gap-2">
                            <MudAvatar Size="Size.Small" Color="Color.Secondary" Variant="Variant.Filled" Style="font-size: 10px; width: 24px; height: 24px;">
                                @(!string.IsNullOrEmpty(blog.AuthorName) ? blog.AuthorName[0].ToString().ToUpper() : "?")
                            </MudAvatar>
                            <MudText Typo="Typo.caption" Class="font-bold text-gray-700">@blog.AuthorName</MudText>
                        </div>

                        <div class="d-flex align-center gap-4">
                            <div class="d-flex align-center gap-1 text-gray-400">
                                <MudIcon Icon="@Icons.Material.Outlined.ThumbUp" Size="Size.Small" style="font-size: 16px;" />
                                <MudText Typo="Typo.caption">@blog.Likes?.Count</MudText>
                            </div>
                            <div class="d-flex align-center gap-1 text-gray-400">
                                <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Small" style="font-size: 16px;" />
                                <MudText Typo="Typo.caption">@blog.Comments?.Count</MudText>
                            </div>
                            <MudIcon Icon="@Icons.Material.Outlined.BookmarkAdd" Size="Size.Small" Class="text-gray-300 hover:text-primary" />
                        </div>
                    </div>
                </div>
            </MudPaper>
        }
    </div>

</MudContainer>

